# TODO: Welsh translations to be supplied by content team.
vehicleIdentificationNumbers.title = Vehicle identification numbers
vehicleIdentificationNumbers.caption = Add vehicle details
vehicleIdentificationNumbers.heading.1 = Vehicle identification numbers
vehicleIdentificationNumbers.paragraph.1 = You must add the vehicle identification number (VIN) for each vehicle you’re notifying HMRC about. The VIN is also known as the chassis or frame number. It can be up to 17 characters long. If it includes:
vehicleIdentificationNumbers.list.1 = O or Q, replace them with 0 (zero)
vehicleIdentificationNumbers.list.2 = I, replace it with 1 (one)
vehicleIdentificationNumbers.paragraph.2 = For example, 1ABCD2E03FG456789.
vehicleIdentificationNumbers.heading.2 = How do you want to add vehicle identification numbers?
vehicleIdentificationNumbers.radio.enterManually = Enter manually
vehicleIdentificationNumbers.radio.enterManually.hint = Enter the VIN for each vehicle, separated by a comma
vehicleIdentificationNumbers.radio.uploadCsv = Upload a CSV file
vehicleIdentificationNumbers.radio.uploadCsv.hint = Must be a comma-separated values (CSV) file type
vehicleIdentificationNumbers.error.required = Select how you want to add the vehicle identification numbers

